{
  "name": "gh-actions",
  "displayName": "GitHub Actions",
  "description": "GitHub Actions runs, jobs and failed-step logs for the selected thread's pull request: rerun, cancel, send a failure to Claude, and a thread flag when a run fails.",
  "repo": "alexwaumann/code-foundry-plugin-gh-actions",
  "version": "0.1.1",
  "protocol": 1,
  "permissions": {
    "commands": [
      "pr.checks",
      "thread.send",
      "view.open.url"
    ],
    "events": [
      "gh",
      "threads"
    ],
    "threadStatus": true,
    "sessionEnv": false,
    "secrets": false,
    "threads": false,
    "terminals": false,
    "api": false
  },
  "artifacts": {
    "darwin/amd64": {
      "url": "https://github.com/alexwaumann/code-foundry-plugin-gh-actions/releases/download/v0.1.1/gh-actions-0.1.1-darwin-amd64.tar.gz",
      "sha256": "7201b7e9ae0c5b8f1446309e9957ede47c790a2502c059f28cf6c0939c203d37"
    },
    "darwin/arm64": {
      "url": "https://github.com/alexwaumann/code-foundry-plugin-gh-actions/releases/download/v0.1.1/gh-actions-0.1.1-darwin-arm64.tar.gz",
      "sha256": "a83363e150a4997090401f5f8c16b8d4fbbfb4fe6e8f8e1f541589fab945845d"
    }
  }
}
