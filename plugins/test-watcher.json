{
  "name": "test-watcher",
  "displayName": "Test Watcher",
  "description": "Runs the project's tests in a thread's worktree whenever files change, shows failures and output in the side panel, flags the thread while tests fail (until they pass or you clear it), and sends failures to Claude.",
  "repo": "alexwaumann/code-foundry-plugin-test-watcher",
  "version": "0.1.3",
  "protocol": 1,
  "permissions": {
    "commands": [
      "thread.send"
    ],
    "events": [
      "project",
      "threads"
    ],
    "threadStatus": true,
    "sessionEnv": false,
    "secrets": false,
    "threads": false,
    "terminals": true,
    "api": false
  },
